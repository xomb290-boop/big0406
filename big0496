-- FOV Circle setup
local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 1.5
FOVCircle.NumSides = 100
FOVCircle.Radius = Settings.AimbotFOV
FOVCircle.Filled = false
FOVCircle.Visible = false
FOVCircle.Color = Color3.fromRGB(255, 255, 255)

local CenterLine = Drawing.new("Line")
CenterLine.Thickness = 1
CenterLine.Color = Color3.fromRGB(255, 0, 0)
CenterLine.Visible = false

local hue = 0

-- Main RenderLoop
RunService.RenderStepped:Connect(function()
    local Char = LocalPlayer.Character
    if Char and Char:FindFirstChild("Humanoid") then
        -- WalkSpeed & JumpPower
        if Settings.WalkSpeedEnabled then
            Char.Humanoid.WalkSpeed = Settings.WalkSpeed
        end
        if Settings.JumpPowerEnabled then
            Char.Humanoid.UseJumpPower = true
            Char.Humanoid.JumpPower = Settings.JumpPower
        end
        
        -- Anti Ragdoll
        if Settings.AntiAntiRagdoll then
            Char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            Char.Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        end
        
        -- Infinite Stamina
        if Settings.InfiniteStamina then
            if Char:FindFirstChild("Stamina") then
                Char.Stamina.Value = 100
            elseif LocalPlayer:FindFirstChild("Stamina") then
                LocalPlayer.Stamina.Value = 100
            end
        end
    end
    
    -- Item Magnet (ดูดของตกเข้าตัว)
    if Settings.ItemMagnet and Char and Char:FindFirstChild("HumanoidRootPart") then
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Tool") or v:IsA("Model") and v:FindFirstChild("Handle") then
                local part = v:FindFirstChild("Handle") or v.PrimaryPart
                if part and (part.Position - Char.HumanoidRootPart.Position).Magnitude < 50 then
                    part.CFrame = Char.HumanoidRootPart.CFrame
                end
            end
        end
    end

    -- FOV Render & Rainbow FOV
    local mousePos = UserInputService:GetMouseLocation()
    FOVCircle.Position = mousePos
    FOVCircle.Radius = Settings.AimbotFOV
    FOVCircle.Visible = Settings.Aimbot
    
    if Settings.RainbowFOV then
        hue = (hue + 0.005) % 1
        FOVCircle.Color = Color3.fromHSV(hue, 1, 1)
    else
        FOVCircle.Color = Color3.fromRGB(255, 255, 255)
    end
    
    -- Center line for Aim
    if Settings.Aimbot then
        CenterLine.Visible = true
        CenterLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        CenterLine.To = mousePos
    else
        CenterLine.Visible = false
    end
end)

-- Auto Respawn
LocalPlayer.CharacterAdded:Connect(function(Char)
    local Hum = Char:WaitForChild("Humanoid")
    Hum.Died:Connect(function()
        if Settings.AutoRespawn then
            task.wait(0.5)
            LocalPlayer:LoadCharacter()
        end
    end)
end)

-- Anti-Silent Aim (Jitter/Desync Spoofer)
RunService.Heartbeat:Connect(function()
    if Settings.AntiSilentAim and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local oldVel = hrp.Velocity
        hrp.Velocity = Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100))
        RunService.RenderStepped:Wait()
        hrp.Velocity = oldVel
    end
end)

-- Double Tap x2
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.UserInputType == Enum.UserInputType.MouseButton1 and Settings.DoubleTap then
        task.wait(0.05)
        -- จำลองการยิงรอบที่สอง
        mouse1click()
    end
end)

-- Wallbang Setup
local mt = getrawmetatable(game)
local oldIndex = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if Settings.Wallbang and (method == "FindPartOnRayWithIgnoreList" or method == "Raycast") then
        -- ข้ามคำสั่งตรวจสอบสิ่งกีดขวาง/กำแพง
        local args = {...}
        return oldIndex(self, unpack(args))
    end
    return oldIndex(self, ...)
end)
setreadonly(mt, true)

